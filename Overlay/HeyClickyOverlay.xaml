<Window x:Class="HeyClicky.Overlay.HeyClickyOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeyClicky Overlay" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        WindowState="Maximized"
        IsHitTestVisible="False">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        
        <!-- Futuristic Ripple Target Marker (Appears only during mouse targeting) -->
        <Canvas x:Name="TargetMarkerGroup" Visibility="Collapsed">
            <Ellipse x:Name="TargetRipple" Width="60" Height="60" Stroke="#0EA5E9" StrokeThickness="1.5" Opacity="0.5">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#0EA5E9" BlurRadius="12" ShadowDepth="0"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="TargetMarker" Width="30" Height="30" Stroke="#0EA5E9" StrokeThickness="2.5" Fill="#330EA5E9" Canvas.Left="15" Canvas.Top="15">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#0EA5E9" BlurRadius="6" ShadowDepth="0"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="6" Height="6" Fill="#0EA5E9" Canvas.Left="27" Canvas.Top="27"/>
        </Canvas>
    </Canvas>
</Window>
