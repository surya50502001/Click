<Window x:Class="HeyClicky.Overlay.HeyClickyOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeyClicky Overlay" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        WindowState="Maximized"
        IsHitTestVisible="False">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        
        <!-- Status indicator (top right) -->
        <StackPanel x:Name="StatusPanel" Canvas.Right="20" Canvas.Top="20" Orientation="Horizontal" Background="#80000000" Margin="10">
            <Ellipse Width="15" Height="15" Fill="Cyan" Margin="10,5,5,5" x:Name="StatusDot">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Window.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="StatusDot" 
                                                 Storyboard.TargetProperty="Opacity" 
                                                 From="1.0" To="0.5" Duration="0:0:1" 
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock x:Name="StatusText" Text="Idle" Foreground="White" Margin="5,5,15,5" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- Target Marker (hidden by default) -->
        <Ellipse x:Name="TargetMarker" Width="40" Height="40" Stroke="Red" StrokeThickness="3" Visibility="Collapsed" Fill="#40FF0000" />
    </Canvas>
</Window>
