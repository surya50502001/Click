<Window x:Class="HeyClicky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeyClicky AI" Height="460" Width="550" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif">

    <Window.Resources>
        <!-- Primary Gradient Button -->
        <Style x:Key="PrimaryGradientButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0284C7" Offset="0.0"/>
                        <GradientStop Color="#0EA5E9" Offset="0.5"/>
                        <GradientStop Color="#38BDF8" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#0EA5E9" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Stop Button -->
        <Style x:Key="DangerStopButton" TargetType="Button">
            <Setter Property="Background" Value="#1E151A"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#991B1B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern High-Contrast Input -->
        <Style x:Key="ModernInputField" TargetType="TextBox">
            <Setter Property="Background" Value="#0B0F19"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter TargetName="border" Property="Background" Value="#080C14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordField" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0B0F19"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter TargetName="border" Property="Background" Value="#080C14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Card with Subtle Glow Border -->
    <Border Background="#111827" CornerRadius="20" BorderBrush="#1F2937" BorderThickness="1.5" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Goal Section -->
                <RowDefinition Height="Auto"/> <!-- API Key Section -->
                <RowDefinition Height="Auto"/> <!-- Actions -->
                <RowDefinition Height="*"/>    <!-- Activity Status Console -->
            </Grid.RowDefinitions>

            <!-- Custom Drag Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar Badge -->
                <Grid Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="14" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5">
                        <Border.Effect>
                            <DropShadowEffect Color="#38BDF8" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <Border CornerRadius="12" Margin="2" ClipToBounds="True">
                            <Image Source="/Assets/avatar.jpg" Stretch="UniformToFill"/>
                        </Border>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="HeyClicky" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Background="#0C4A6E" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AI COMPANION" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Visual Computer-Use Automation Agent" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Window Close / Minimize Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource WindowControlButton}" Content="─" Click="MinimizeButton_Click" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource WindowControlButton}" Content="✕" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Goal Section -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="GOAL" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                <TextBox x:Name="CommandTextBox" Style="{StaticResource ModernInputField}" Height="42" 
                         Text="Open Chrome and search for flowers" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- API Key Section -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                    <TextBlock Text="GEMINI API KEY" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                        <TextBlock Text="Saved locally (.gitignore)" FontSize="9.5" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>
                <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource ModernPasswordField}" Height="40" 
                             PasswordChanged="ApiKeyBox_PasswordChanged" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StopButton" Style="{StaticResource DangerStopButton}" Content="■ Stop Agent" 
                            Width="120" Height="42" Click="StopButton_Click" IsEnabled="False" Margin="0,0,10,0"/>
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryGradientButton}" Content="⚡ Run Agent" 
                            Width="140" Height="42" Click="RunButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Live Status Terminal Card -->
            <Border Grid.Row="4" Background="#0B0F19" CornerRadius="12" Padding="14,10" 
                    BorderBrush="#1E293B" BorderThickness="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Live Pulsing Status Dot -->
                    <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse x:Name="StatusDotGlow" Width="14" Height="14" Fill="#38BDF8" Opacity="0.3"/>
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <TextBlock x:Name="LogText" Grid.Column="1" Text="Ready. Enter your goal and click Run Agent." 
                               Foreground="#E2E8F0" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
